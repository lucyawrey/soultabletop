# PostgresDB connection string
DATABASE_URL=
# Better Auth secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# API key for the Resend email service
EMAIL_API_KEY=
# Optional, local only: your own Soul Tabletop API key (create one on /profile)
# for development scripts that call the API as you; the app doesn't read it
SOUL_TABLETOP_API_KEY=