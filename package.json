{
  "name": "soultabletop",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build --dotenv .env.local",
    "dev": "nuxt dev --dotenv .env.local",
    "preview": "nuxt preview --dotenv .env.local",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "admin:set": "node --env-file-if-exists=.env.local scripts/set-site-admin.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "check:templates": "node scripts/check-templates.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.6",
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@iconify-json/lucide": "^1.2.134",
    "@iconify-json/simple-icons": "^1.2.96",
    "@nuxt/ui": "^4.11.1",
    "@scalar/nuxt": "0.6.74",
    "@sinclair/typebox": "^0.34.52",
    "@vercel/functions": "^3.9.9",
    "@vueuse/integrations": "^14.4.0",
    "better-auth": "^1.7.6",
    "codemirror": "^6.0.2",
    "drizzle-orm": "^0.45.3",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/sortablejs": "^1.15.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.5.1"
}
