{
  "readableId": "pf2e-class-feature",
  "name": "Class Feature",
  "contentCategory": "general",
  "hasStrictSchema": true,
  "schema": {
    "level": {
      "type": "number",
      "label": "Level",
      "default": 1
    },
    "actions": {
      "type": "string",
      "options": [
        {
          "value": "passive",
          "label": "Passive"
        },
        {
          "value": "1",
          "label": "One action"
        },
        {
          "value": "2",
          "label": "Two actions"
        },
        {
          "value": "3",
          "label": "Three actions"
        },
        {
          "value": "free",
          "label": "Free action"
        },
        {
          "value": "reaction",
          "label": "Reaction"
        }
      ],
      "label": "Actions",
      "default": "passive"
    },
    "traits": {
      "type": "array",
      "label": "Traits",
      "itemType": {
        "type": "string"
      }
    },
    "rarity": {
      "type": "string",
      "options": [
        {
          "value": "common",
          "label": "Common"
        },
        {
          "value": "uncommon",
          "label": "Uncommon"
        },
        {
          "value": "rare",
          "label": "Rare"
        },
        {
          "value": "unique",
          "label": "Unique"
        }
      ],
      "label": "Rarity",
      "default": "common"
    },
    "description": {
      "type": "string",
      "label": "Description",
      "description": "Rules text, in Markdown."
    },
    "source": {
      "type": "string",
      "label": "Source",
      "description": "The book it was published in."
    }
  }
}
