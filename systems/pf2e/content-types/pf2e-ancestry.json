    "rarity": {
      "type": "string",
      "options": [
        {
          "value": "common",
          "label": "Common"
        },
        {
          "value": "uncommon",
          "label": "Uncommon"
        },
        {
          "value": "rare",
          "label": "Rare"
        },
        {
          "value": "unique",
          "label": "Unique"
        }
      ],
      "label": "Rarity",
      "default": "common"
    },
    "description": {
      "type": "string",
      "label": "Description",
      "description": "Rules text, in Markdown."
    },
    "source": {
      "type": "string",
      "label": "Source",
