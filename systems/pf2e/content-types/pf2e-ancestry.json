    "vision": {
      "type": "string",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "low-light-vision",
          "label": "Low-Light Vision"
        },
        {
          "value": "darkvision",
          "label": "Darkvision"
        }
