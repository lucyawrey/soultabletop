                {
                  "value": "str",
                  "label": "Strength"
                },
                {
                  "value": "dex",
                  "label": "Dexterity"
                },
                {
                  "value": "con",
                  "label": "Constitution"
                },
                {
                  "value": "int",
                  "label": "Intelligence"
                },
                {
                  "value": "wis",
                  "label": "Wisdom"
                },
                {
                  "value": "cha",
                  "label": "Charisma"
                }
              ],
              "label": "Attribute"
            }
          }
        }
      }
    },
    "flaws": {
      "type": "array",
      "label": "Attribute Flaws",
      "itemType": {
        "type": "string",
        "options": [
          {
            "value": "str",
            "label": "Strength"
          },
          {
            "value": "dex",
            "label": "Dexterity"
          },
          {
            "value": "con",
            "label": "Constitution"
          },
          {
            "value": "int",
            "label": "Intelligence"
          },
          {
            "value": "wis",
            "label": "Wisdom"
          },
          {
            "value": "cha",
            "label": "Charisma"
          }
        ],
        "label": "Attribute"
      }
