{
  "readableId": "pf2e-ancestry",
  "name": "Ancestry",
  "contentCategory": "general",
  "hasStrictSchema": true,
  "schema": {
    "hp": {
      "type": "number",
      "label": "Hit Points",
      "required": true
    },
    "size": {
      "type": "string",
      "options": [
        {
          "value": "tiny",
          "label": "Tiny"
        },
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "med",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
