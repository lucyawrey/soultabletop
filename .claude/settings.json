{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/agent-run.sh pnpm check)",
      "Bash(.claude/scripts/agent-run.sh pnpm check *)",
      "Bash(.claude/scripts/agent-run.sh pnpm typecheck)",
      "Bash(.claude/scripts/agent-run.sh pnpm lint)",
      "Bash(.claude/scripts/agent-run.sh pnpm test)",
      "Bash(.claude/scripts/agent-run.sh pnpm test *)",
      "Bash(.claude/scripts/agent-run.sh pnpm check:templates*)",
      "Bash(.claude/scripts/agent-run.sh pnpm exec eslint *)",
      "Bash(.claude/scripts/agent-run.sh pnpm exec vitest run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch origin)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(scripts/check-secrets.sh)",
      "Bash(scripts/check-secrets.sh *)",
      "Bash(git worktree list*)",
      "Bash(gh pr checks *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/agent-run.sh\" node \"$CLAUDE_PROJECT_DIR/scripts/check-templates.mjs\" --hook 1>&2"
          }
        ]
      }
    ]
  }
}
